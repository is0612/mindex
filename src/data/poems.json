[{"id":"qz1781661363","title":"卜算子·故北停新雪","genre":"词","date":"2026-01-21","volumeNo":3,"body":["故北停新雪，","江淮日月恒。","何事远书没西楼，","年岁又一程。","","旧乡时悠乱，","寒雨夜入城。","人心难变似往常，","无意付流生。"]},{"id":"qz1781661261","title":"行也迟迟坐也迟","genre":"七言","date":"2025-05-30","volumeNo":3,"body":["行也迟迟坐也迟，","金丝暗度紫纱连。","江淮并无春色近，","也择一枝没酒钱。"]},{"id":"qz1781661206","title":"临江仙·春晚未及夏热","genre":"词","date":"2025-05-04","volumeNo":3,"body":["春晚未及夏热，","钱塘几丈思量。","金丝蓝缎画江南，","竹西雨未透，","柳絮漫天长。","","古城老街一半，","过往两段京杭。","似是别离也相逢，","今朝酒并露，","浅月挂幽黄。"]},{"id":"qz1781661125","title":"卜算子·朝花不堪拾","genre":"词","date":"2025-01-04","volumeNo":3,"body":["朝花不堪拾，","老月逢新年。","江淮秋雁孤飞来，","原君好梦还。","","四海皆在北，","归期久未谈。","流云碎却今朝事，","闲情莫当年。"]},{"id":"qz1736929102","title":"锦彩纷纷挂别枝","genre":"古体","date":"2024-03-28","volumeNo":3,"body":["锦彩纷纷挂别枝，","云浮墨雨山渐青。","邻家好酒邀相去，","院里池塘一丈清。"]},{"id":"qz1736929086","title":"卸马系青舟","genre":"古体","date":"2023-11-19","volumeNo":3,"body":["卸马系青舟，不见秋风凉。","明月山有色，江海浪无形。","晚钟生暮雨，夜影对长亭。","缘浅不经催，难驻故人情。"]},{"id":"qz1679888495","title":"时光易逝人易老","genre":"七言","date":"2023-03-27","volumeNo":3,"body":["时光易逝人易老，","梦里迢迢梦里遥。","常见青山换绿叶，","玉柳何处弄妖娆。"]},{"id":"qz1736929023","title":"长相思·多情作别游","genre":"词","date":"2023-01-11","volumeNo":3,"body":["风也忧，","云也忧，","寒雨无事入西洲，","相思系流舟。","","爱也愁，","恨也愁，","浮生难换一回眸，","多情作别游。"]},{"id":"qz1736928990","title":"临江仙·花洲新客","genre":"词","date":"2022-09-06","volumeNo":3,"body":["白梳莲子清风酒，","幽草芳菲轻驻。","斜阳侧畔浮玉影，","美景不多时，","关山隐秋暮。","","千载光阴凭谁述，","往事闲愁争渡。","夜半归旅还新梦，","明月无需有，","映我心欢处。"]},{"id":"qz1652027145","title":"一剪梅·风雨无情摧残舟","genre":"词","date":"2022-05-09","volumeNo":3,"body":["风雨无情摧残舟，","四海迷离，","轻影漂浮。","夜冷总寻心上光，","春也晚暮，","何是归途。","","谁人念我多忧愁，","锦书频断，","家信常余。","芳华年年皆依旧，","岁月共挽，","莫叹孤独。"]},{"id":"qz1638705948","title":"卜算子·君愿知","genre":"词","date":"2021-12-05","volumeNo":3,"body":["风云多变化，","草木叶常衰。","求神求仙莫求道，","又将故人拆。","","世无双全法，","往事难寻思。","剑荡八荒妖魔怪，","愿知君莫哀。"]},{"id":"qz1635348613","title":"记岛遇","genre":"古体","date":"2021-10-27","volumeNo":3,"body":["霜化秋水日渐寒，四季此时最无常。","风染长林情初动，月落西城夜永恒。","刹那芳华多依旧，半世流年更悠长。","归来未觉已思念，江湖路远再相逢。"]},{"id":"qz1634396521","title":"长相思·黄昏月下秋","genre":"词","date":"2021-10-16","volumeNo":3,"body":["天长久，","人长久。","银装金扇叶眉柳，","红烛酌新酒。","","情难休，","爱难休。","晓意心盟喜事羞，","黄昏月下秋。"]},{"id":"qz1633775387","title":"卜算子· 风波卷云浪","genre":"词","date":"2021-10-09","volumeNo":3,"body":["风波卷云浪，","雨气平秋分。","十年一剑梦如今，","旧词执念深。","","回首花还在，","落笔情更真。","愿此事了得见卿，","轻寒不住身。"]},{"id":"qz1629636603","title":"浪淘沙·夜路","genre":"词","date":"2021-08-22","volumeNo":3,"body":["四海无处留，","月往高楼，","青梅酒短难入喉。","茶过两盏断归途，","走马绝候。","","天涯任我游，","常有忧愁，","何将此事挂心头。","星海辽阔夜温柔，","微语低眸。"]},{"id":"qz1628099306","title":"长相思·天亦远","genre":"词","date":"2021-08-05","volumeNo":3,"body":["天亦远，","人亦远，","愁云半缕月色浅，","朱帘空自掩。","","人不愿，","天不愿，","小楼独酌饮欢宴，","浮生就此散。"]},{"id":"qz1622547938","title":"小重山·微风晚雨夜自凉","genre":"词","date":"2021-06-01","volumeNo":3,"body":["微风晚雨夜自凉，","泪眼应天垂、已无声。","昨夜是非成旧梦。","何处醉，","醒来也迷茫。","","孤灯映双影。","命里锁千劫、困心境。","此去唯忆共流光。","相思怯，","难再与君同。"]},{"id":"qz1614177927","title":"清平乐·君莫思归","genre":"词","date":"2021-02-24","volumeNo":3,"body":["君莫思归，","前路多漫长。","春鸿秋雁各散去，","她自笑掩红妆。","","车马来人不断，","路上彩蝶双双。","此后红尘有伴，","流水落花轻殇。"]},{"id":"qz1612695185","title":"小重山·故梦","genre":"词","date":"2021-02-07","volumeNo":3,"body":["二十四声弦外音。","旧忆无可念、故梦频。","三载忧愁客又新。","忽来诉，","私语不由心。","","阳关锁瑶琴。","楼阁空自叹、西风尽。","暮起寒酒向君饮。","杯难碰，","微雨断回信。"]},{"id":"qz1604820988","title":"苏幕遮·长亭外","genre":"词","date":"2020-11-08","volumeNo":3,"body":["长亭外，","月朦胧。","玉影随风，","痴心付飞鸿。","奈何秋意也朦胧。","执伞难送，","往事已无踪。","","回首处，","晓意浓。","离人泪涌，","花落掩深红。","胭脂信手为谁容。","美景匆匆，","情衷各不同。"]},{"id":"qz1593513963","title":"苏幕遮·旧愁","genre":"词","date":"2020-06-30","volumeNo":3,"body":["黄昏起，","白驹过。","庆忌未迁，","非哉也轻诺。","谁说有缘来相会，","任凭喜悲，","新客旧愁多。","","心路短，","天涯阔。","杯酒随意，","夕暮他乡落。","坦尾珠江花水岸，","陈词唱罢，","又是相思错。"]},{"id":"qz1593437176","title":"西洲何处寄深情","genre":"七言","date":"2020-06-29","volumeNo":3,"body":["一载孤月几人愁，","半壶银光落流萤。","此夜若得南风过，","西洲何处寄深情。"]},{"id":"qz1593341363","title":"长相思·归故","genre":"词","date":"2020-06-28","volumeNo":3,"body":["行无处，","坐无处，","四海苍茫无归处，","黄昏躲云暮。","","人无数，","车无数，","此间喧闹我知故，","我随黄昏去。"]},{"id":"qz1590327499","title":"长相思·依旧","genre":"词","date":"2020-05-24","volumeNo":3,"body":["月依旧，","云依旧，","几许思绪情依旧，","回首人依旧。","","起几笔，","落几笔，","闲云落花谁提笔，","回首欲休止。"]},{"id":"qz1587223660","title":"苏幕遮·红尘叹","genre":"词","date":"2020-04-18","volumeNo":3,"body":["红尘叹，","凡世安。","蜉蝣难争，","天命日落山。","流莺秋鸿各行处，","生死何依，","悲鸣也不堪。","将子时，","闹市喧。","踟蹰门外，","恍觉非帝轩。","此后不论成与非，","归去来兮，","原处是新帆。"]},{"id":"qz1586780847","title":"世事有常数","genre":"古体","date":"2020-04-13","volumeNo":3,"body":["世事有常数，枝头无双叶。","风华兼才茂，能人与志士。","贤者多寂寞，凡汉少知己。","无酒亦醉去，唱出荒唐戏。"]},{"id":"qz1586711796","title":"一剪梅·芙蓉畔","genre":"词","date":"2020-04-13","volumeNo":3,"body":["一幕轻舟南北过，","不问子丑，","看罢星辰。","历水阁楼谁低语，","清莲幽落，","以沫红尘。","","芙蓉可予他人赏，","当年风范，","何生浮沉。","旧事多忘难觅处，","丹青易画，","姿绪无痕。"]},{"id":"qz1584612146","title":"长相思·归了","genre":"词","date":"2020-03-19","volumeNo":3,"body":["春归了，","人归了。","遍地闲花逢春晓，","自是浮生巧。","","人去了，","春去了。","柳芽新叶别处窕，","烟雨青山脚。"]},{"id":"qz1582272410","title":"长相思·生尽欢","genre":"词","date":"2020-02-21","volumeNo":3,"body":["生尽欢，","余尽欢。","落红无情舍椿萱，","潇洒云雨间。","","曲未散，","人未散。","时光难回昨夜漫，","流水过千帆。"]},{"id":"qz1580572326","title":"苏幕遮·祈灵","genre":"词","date":"2020-02-01","volumeNo":3,"body":["墨子兮，","白衣弦。","梦外无常，","饮酒恰清欢。","起灵送轿十里妆，","朱砂红墙，","断却半生缘。","情深种，","誓轻言。","七年牵绊，","散去若云烟。","落雨清风君何故，","可叹无情，","换去此生闲。"]},{"id":"qz1580355392","title":"江城子·浮沉","genre":"词","date":"2020-01-30","volumeNo":3,"body":["人生何处起浮沉？","起高楼，","论君臣。","桃园煮酒，","铁马久封尘。","孑然一身恍惊叹，","无帐士，","摘星辰。","红颜多喜英雄色，","难惶恐，","落孤魂。","是非已了，","情愁过三旬。","且让闲客水流东，","持九剑，","战乾坤。"]},{"id":"qz1579276868","title":"成故","genre":"古体","date":"2020-01-18","volumeNo":3,"body":["故人何时遇，微风月浅眠。","才轻寒几许，凝眸泪烟悬。","故人早已去，嗟然无所念。","残墙不颐和，沧海二十弦。","故人曾依依，故我也翩翩。","故人已远去，天涯何处安。"]},{"id":"qz1577041347","title":"勿往","genre":"古体","date":"2019-12-23","volumeNo":2,"body":["今夜凉兮寂语，长相守兮妄言。","美景悦兮秦淮，雨花石兮怨天。","西洲曲兮怀北，凉生词兮毋告安。","幽暝月兮思过，隔山海兮怅妄安。","勿念往兮樱落，沉木梳兮黄纸。","长梦殇兮泪止，时光浅兮伤离。","提纸墨兮多疑，众人看兮不相知。","后写诗兮予怀，君不见兮亦不知。"]},{"id":"qz1570101271","title":"一抹桃花","genre":"古体","date":"2019-10-03","volumeNo":2,"body":["一抹桃花春，一世倾无双。","久住长安里，未及泸州城。","春花春去浅，春花秋去殇。","芳华无相顾，一抹春两厢。"]},{"id":"qz1566673588","title":"一剪梅·别克","genre":"词","date":"2019-08-25","volumeNo":2,"body":["世间多是起浮躁，","烈火宝马，","各路熊虎。","沉诗宴楚王侯事，","举兵天命，","秋后白骨。","伊人请赏封神将，","高音明胜，","无声细语。","可叹长情不经意，","如花易散，","曾许千古。"]},{"id":"qz1565349521","title":"苏幕遮·初九","genre":"词","date":"2019-08-09","volumeNo":2,"body":["清风侧，","月暖秋。","鹊桥已散，","痴情人不休。","孤影自眠双影长，","喜结连理，","灵凤绕凰啾。","","月初九，","伴长久。","红烛高挂，","银屏隐兰袖。","方绪霖雨点桂香，","情绵未熏，","醉却交杯酒。"]},{"id":"qz1564753411","title":"知秋","genre":"古体","date":"2019-08-02","volumeNo":2,"body":["天涯过客知秋少，","华灯月影故愁多。","此处折柳挥落泪，","恰似风中舞婆娑。"]},{"id":"qz1559975505","title":"摆渡","genre":"古体","date":"2019-06-08","volumeNo":2,"body":["思春花雨幕，","秋枫白衣候。","兰舟无渡客，","摇摆几度愁。"]},{"id":"qz1556124523","title":"江城子·醉花荫","genre":"词","date":"2019-04-25","volumeNo":2,"body":["闲人莫语醉花荫，","花开时，","花落后。","片片随风，","风染青丝瘦。","待到春风随应我，","夜偏渡，","却无舟。","闲人恐扰清思梦，","只唯一，","成千锁。","云住高楼，","执手续情愁。","应是无双得佳顾，","更无处，","惹回眸。"]},{"id":"qz1554039930","title":"西江月·明月长怜孤影","genre":"词","date":"2019-03-31","volumeNo":2,"body":["明月长怜孤影，","夜半忽扰陈书。","朝暮长存情易逝，","少念红尘旧故。","去年春风又生，","勿拾沉花落木。","闲来聚客取笛笙，","醉却寻欢归处。"]},{"id":"qz1554004208","title":"三月末诗","genre":"七言","date":"2019-03-31","volumeNo":2,"body":["九月惊鸿惹思念，清晓悠悠叹难眠。","今已三月花满天，无酒寻春燕言欢。","故是清香随风远，青丝长留红线牵。","且把温柔闲做伴，浮生过客浮生缘。"]},{"id":"qz1553731248","title":"我愿与你","genre":"古体","date":"2019-03-28","volumeNo":2,"body":["我愿与你去流浪，","在荒郊野岭，","或是星空彼岸。","你穿梭在花海，","我扬起气泡点点。","大漠、田野，","城市、孤岛，","但凡你所向往，","我都愿与你共览。"]},{"id":"qz1550427584","title":"余光","genre":"古体","date":"2019-02-18","volumeNo":2,"body":["多难眠秋梦林深见鹿","星火如辰遮掩余光","一见钟情的模样","过度腐蚀心路苍茫","游鱼流浪仰慕天空","波涛之上燕歌嘹亮","写诗人的故乡","孤灯一盏通明","昨夜相思且漫长","只影在瞭望","梦在远方","一抹红装","炽热坦诚","美目心中流淌","回忆昨夜仅是过往","欢喜是悸动","爱是感伤","漫漫余生","只想与你分享","多难忘回眸一笑倾城","暮光倒影翩若惊鸿","疲倦优雅地模仿","顾盼美好眷恋情长","树影斑斓夜空明净","华灯初上月影成双","你似清风在侧","我似明月彷徨","昨夜相思且漫长","只影在瞭望","梦在远方","一抹红装","炽热坦诚","美目心中流淌","回忆昨夜仅是过往","欢喜是悸动","爱是感伤","漫漫余生","只想与你分享","难掩余光","心事随风回荡","原曲《无双》——寻池"]},{"id":"qz1543938503","title":"破格演出","genre":"古体","date":"2018-12-04","volumeNo":2,"body":["过往回忆都在真实浮现迷幻泪水遮住内心表面","我本该活在童话世界","用水晶鞋交换面包宫殿","爱情与物质在耳边萦绕","我听不到你真情的呼唤","童话也会有太多遗憾","小丑表演总是完美欺骗","与他相遇","只是我的破格演出","条件苛刻","表演不要太认真","与你相聚","成为我的破格演出","意识迟钝","祝福难免变换主人","国王举着盾牌不可违反","炫耀带你远离我的视线","卸下面具还是那张脸","等闲尘埃不该入侵你眼","当电视剧模拟浪漫心愿","透明玻璃承受破碎勇敢","告别途中也忽然断线","平凡日子成为特殊纪念","你说人心会变","不顾昨天遗忘的微笑","花心思装饰厨房","为自己献上一条美人鱼","天空在地上绚丽旋转","装修建议显得多么诚恳","全新抱枕勾住时光过往","还牵引了出了天亮的床垫","与他相遇","只是我的破格演出","没有天份","表演不要太认真","与你相聚","成为我的破格演出","改变停歇","祝福只能更换主人"]},{"id":"qz1543581723","title":"苏幕遮·往事只能回味","genre":"词","date":"2018-11-30","volumeNo":2,"body":["红砖墙，","黄泥路。","扶桑酿酒，","深埋花落处。","两小无猜且作伴，","围墙轻过，","午后寻棺木。","","天色清，","烟火纯。","夏虫齐鸣，","夜晚探星辰。","又把浴巾做披风，","中元节里，","拾枝闹鬼魂。"]},{"id":"qz1541949495","title":"江城子·过往","genre":"词","date":"2018-11-11","volumeNo":2,"body":["子夜相逢子夜长，","听风语，","化蝶飞。","他人自喜，","忘顾车马催。","夏雨初荷夜画眉，","便此生，","心无悔。","","不惜花前不惜卿，","朱颜逝，","忍憔悴。","残影入梦，","梦醒君不归。","回首蓦然成过客，","此生后，","心无悔。"]},{"id":"qz1537855405","title":"十里清风旧繁华","genre":"七言","date":"2018-09-25","volumeNo":2,"body":["十里清风旧繁华，","诉卿芳容渐朦胧。","只道当时春尚浅，","斜阳细柳玉玲珑。"]},{"id":"qz1536976480","title":"长相思·旧诗词","genre":"词","date":"2018-09-15","volumeNo":2,"body":["新诗词，","旧诗词，","余生无故作别离，","提笔忘长辞。","相见兮，","不见兮，","早知心乱断青丝，","夜半听雨滴。"]},{"id":"qz1534862141","title":"临江仙","genre":"词","date":"2018-08-21","volumeNo":2,"body":["秋后天涯两岸，","久别未允相逢。","小半清欢似情长。","当年罗裙动，","明月沛鸿亭。","","仍记蹙眉轻折，","低语便知心伤。","今道来年嫁新郎。","总是盼归时，","云深月无踪。"]},{"id":"qz1531041490","title":"眠星","genre":"古体","date":"2018-07-08","volumeNo":2,"body":["旧城多风雨，","晓梦顾长清。","莫说离别后，","萤光夜眠星。"]},{"id":"qz1526457175","title":"苏幕遮·凉生","genre":"词","date":"2018-05-16","volumeNo":2,"body":["大明湖，","旧石阶，","手心朱砂，","鼓巷惜并肩。","云龙湖畔落阳天，","青舟荡远，","小城古楼偏。","","子夜长，","泪痕掺。","挽歌难唱，","空盟续情喧。","徒把凉生尽温柔，","千家月色，","他人共婵娟。"]},{"id":"qz1526430468","title":"梦见","genre":"古体","date":"2018-05-16","volumeNo":2,"body":["来生谁偕老，","离殇君不知。","情深终似浅，","入梦无归期。"]},{"id":"qz1525980168","title":"忆萱","genre":"古体","date":"2018-05-11","volumeNo":2,"body":["三世情深莫相欺，","萱花飘落叹缤纷。","此间不做回头客，","半生浮梦半君心。"]},{"id":"qz1525762312","title":"采桑子·锦书无寄","genre":"词","date":"2018-05-08","volumeNo":2,"body":["一语平常百家言，","莫道相思。","莫道相思，","不知新词为谁题。","","如今难语上高楼，","锦书无寄。","锦书无寄，","千言万语随风逝。"]},{"id":"qz1525630961","title":"卜算子·何故与君见","genre":"词","date":"2018-05-07","volumeNo":2,"body":["何故与君见，","清风伴月眠。","小楼寂语无人念，","孤灯夜朱帘。","柳絮已满天，","青舟终去还。","悔知情深莫轻负，","浮生又几年。"]},{"id":"qz1525627641","title":"西江月·相思不相见","genre":"词","date":"2018-05-07","volumeNo":2,"body":["赌酒徒剩悲欢，","红尘白留一面。","莫说相思不相见，","挥手了却执念。","青稞未探深世，","误识良辰嘉宴。","只道春风不曾吹，","却绿江南一岸。"]},{"id":"qz1518011641","title":"临江仙","genre":"词","date":"2018-02-07","volumeNo":2,"body":["夜半小楼高语，","柳垂却记离殇。","寸寸光阴随过往。","几许人间去，","可曾共沧桑。","","东风轻送喜帖，","忘了何处清香。","旧词明月百花窗。","二月春尚浅，","银烛与红妆。"]},{"id":"qz1512446498","title":"凤北","genre":"古体","date":"2017-12-05","volumeNo":2,"body":["又是这一年","黄昏不再温暖","粒粒下的雪","你说轻轻呢","你我仍向往","故乡阳光的雨","没有寒冷","也没有你我","这里和我一样","渐渐少了你","这里是否和我一样","心里藏着秘密","也想着你","你在黑夜里","时而歌唱","时而哭泣","这里的南方","时而偏北","凤凰北去","时而不还","你忘了岁月","时而入眠"]},{"id":"qz1511948334","title":"莫生","genre":"七言","date":"2017-11-29","volumeNo":2,"body":["此间有情两不猜，","繁华流年若浮生。","后知君心曾寄月，","只为一人弄风骚。"]},{"id":"qz1511202177","title":"长相思·惜双双","genre":"词","date":"2017-11-21","volumeNo":2,"body":["听一声，","叹一声，","凡烛难燃千夜灯，","剪去一双双。","昨夜梦，","今夜梦，","梦已成真无处梦，","繁华终成梦。"]},{"id":"qz1511200506","title":"苏幕遮·有情燕","genre":"词","date":"2017-11-21","volumeNo":2,"body":["燕离巢，","北不还。","淡看孤舟，","夜雨又偏寒。","此生来世无他续，","且忘初心，","不做有情燕。","","功与名，","未曾谈。","光阴渐逝，","困倚烛灯看。","日日朝夕君不见，","莫笑离愁，","一场空怀念。"]},{"id":"qz1510383124","title":"秋落十二言","genre":"七言","date":"2017-11-11","volumeNo":2,"body":["故人明月已朦胧，昨夜星辰却玲珑。","烛火轻燃君在侧，误惹痴情无相逢。","一年花开一时落，强词新赋付流萤。","巧叶无忧解香语，红杏含笑玉海棠。","不知君心何处落，玉影随风情已忘。","徒留春鸿寻秋燕，七世青鸟一夜凤。"]},{"id":"qz1506659393","title":"湖中月","genre":"古体","date":"2017-09-29","volumeNo":2,"body":["本是天上月，","却映湖中心。","君喜湖中月，","不知天上明。"]},{"id":"qz1506659318","title":"未思","genre":"古体","date":"2017-09-29","volumeNo":2,"body":["卿在千里外，未语我心忧。","不忍卿蹙眉，卿愁我亦愁。","小赋相思引，愿爱存温留。","相思成朝暮，有情共白头。"]},{"id":"qz1505742994","title":"一钱不足酒","genre":"古体","date":"2017-09-18","volumeNo":2,"body":["一钱不足酒，旧事多新逢。","谈心止江汉，相望隔宿城。","多是君子意，少却故人情。","青春常尚好，何顾利与诚。"]},{"id":"qz1493174797","title":"半生缘","genre":"古体","date":"2017-04-26","volumeNo":2,"body":["只知相逢应相识，","春风回转花不重。","一往情深深几许，","回眸刹那半生缘。"]},{"id":"qz1492522502","title":"临江仙·十月二十与君逢","genre":"词","date":"2017-04-18","volumeNo":2,"body":["十月二十与君逢，","怎知青柳轻折。","明月秋心昨夜客，","今生何相逢，","今生已相逢。","","清酒难醉几处愁，","小城小巷小楼。","古藤秋卷已长眠，","不是长安客，","却在长安外。"]},{"id":"qz1485122522","title":"陌客","genre":"古体","date":"2017-01-23","volumeNo":2,"body":["无缘皆过客，","谁念故人情。","人在明月里，","苍茫人海中。"]},{"id":"qz1484449579","title":"浮生赋","genre":"古体","date":"2017-01-15","volumeNo":2,"body":["饶饶浮生赋，年年是归期。","归期不曾顾，相见是人家。","且坐白云去，明月各一方。","忘却明月下，共与浮生息。"]},{"id":"qz1484183588","title":"故里食堂","genre":"古体","date":"2017-01-12","volumeNo":2,"body":["故里旧食堂，","家外年又年。","空留百余味，","不见路归人。"]},{"id":"qz1483444122","title":"江城子·无归","genre":"词","date":"2017-01-03","volumeNo":2,"body":["谁家归燕已成双，","旧墙垣，","人未归。","沛鸿亭外，","明月忆秋衣。","几度年华轻似水，","车马上，","无人催。","","花开花落徒徘徊，","秋子逝，","叶长衰。","箜篌音断，","片片浮生息。","人似未归情已归，","青舟下，","人未归。"]},{"id":"qz1481898758","title":"我的姓氏","genre":"古体","date":"2016-12-16","volumeNo":2,"body":["由何而来","你的名字","是划过的星痕","还是落下的泪光","怎么找得到","怎么看得见","三生石上","书写了谁的姓名","只有路过那奈何桥畔","还是走过了那忘情川上","最终才能瞥见","今生与你的相伴","庆幸在孟婆汤前","仍能记住你的名字","难寻难恋","谁言来世相遇的苦与乐","从此以后无忧无求","从此以后终生难忘","从此以后还会再问","你的名字由何而来"]},{"id":"qz1479469600","title":"无题","genre":"古体","date":"2016-11-18","volumeNo":2,"body":["此时花正好，","花开无人晓。","待得群芳去，","共于岁月老。"]},{"id":"qz1478523248","title":"滁州","genre":"七言","date":"2016-11-07","volumeNo":2,"body":["滁州几度春成夏，","云来云扰又晴空。","秋霞终与夕阳落，","吹去黄杉一夜风。"]},{"id":"qz1478104544","title":"友意","genre":"古体","date":"2016-11-03","volumeNo":2,"body":["人生莫言情，","无情莫相惜。","相惜本无意，","情意自在心。"]},{"id":"qz1475056729","title":"西洲梦","genre":"古体","date":"2016-09-28","volumeNo":2,"body":["梦中无一物，","情深梦不知。","怎诉相思意，","恐卿又相思。"]},{"id":"qz1470925195","title":"七夕","genre":"五言","date":"2016-08-11","volumeNo":2,"body":["银汉浮云上，","思君碧水前。","情深黄昏后，","鹊语夜阑珊。"]},{"id":"qz1470924551","title":"苏幕遮·兰夜","genre":"词","date":"2016-08-11","volumeNo":2,"body":["流萤巧，","西窗前。","彩云轻弄，","罗绮舞星辰。","伊人独醉花灯里，","佳期如梦，","别鹊惊风寒。","","七夕愿，","心中诠。","华灯初上，","孤影月自眠。","小城昨夜南风起，","私语谁聆，","有情结姻缘。"]},{"id":"qz1470222827","title":"苏幕遮·初见","genre":"词","date":"2016-08-03","volumeNo":2,"body":["梦未醒，","情似幻。","昨夜清闲，","误识伊人愿。","七年提笔寻仙侣，","桃花忽落，","翩然入思念。","","初相见，","手轻牵。","缘系天涯，","烟雨落江南。","始得知音入红尘，","万般柔情，","与君共华年。"]},{"id":"qz1465215192","title":"长相思","genre":"词","date":"2016-06-06","volumeNo":2,"body":["长相思，","短相思，","梦里相逢不相知，","梦醒花别枝。","浅回忆，","轻回忆，","一忆浮生少年事，","几度怜卿意。"]},{"id":"qz1463497360","title":"凤凰花","genre":"古体","date":"2016-05-17","volumeNo":2,"body":["凤凰树上凤凰开，","凤凰未至花先衰。","浅忆鸿亭明月下，","花落人亡两不知。"]},{"id":"qz1461951336","title":"古诗十七薯","genre":"七言","date":"2016-04-30","volumeNo":2,"body":["李树花开一夜白，凌晨轻寒疑雪来。","不惧春风早日散，只愿花开有君随。","李花惜雪三月来，雪融花现满枝白。","婷婷春风何时顾，独怜幽院赏玉梅。","曾系千丝缕，静倚相思楼。","怡然赏明月，低语化轻愁。","苫蓑沥沥江南雨，诗古悠悠千年风。","婷婷玉立红尘处，遥看落霞映晴空。","庞眉未现春如面，佳句只识伊人心。","不知今生何相遇，相思湖前又思君。","黄昏易散人难散，尚识昨夜心相印。","洁璘常叹寒宫寂，人间四月有情牵。","金风一朝夕阳晚，子夜常怜月难圆。","嵘华未负相思意，梦中相随几世缘。","周回清风春渐浓，晓莺处处啼花红。","丹青半洒春入画，难描伊人卧江亭。","钟声藏古寺，景迟韵禅音。","仲冬雪初起，晚春落英纷。","来鸿携思意，浮云眷人心。","青阶谁曾顾，回眸月渐偏。","陈宫未觉花暮近，秋雨春燕月如初。","谕与残香落双雁，红尘过客有缘居。","陈年往事谁曾记，博览人间流年逝。","长愿今生心存我，我为今生忆前世。","陈朝新咏七百篇，清风吹尽几世愁。","怡然半语浮生梦，一念长情尽东流。","今朝仍系旧时缘，古人今人又温柔。","唯爱落霞成双影，晓扰心绪为君留。","陈凤飞花引琴瑟，诗惋红蝶夜双栖。","韵语曾怜寒孤影，相识却又苦相思。","陈词新句总难论，积雪落花又浮生。","磊落黄昏春易晚，浅吟夕月念情长。","池面绿柳飘蓬絮，国香幽色醉纷飞。","惠风柔若轻抚面，晚晴含暖雁来归。","石台西畔寻仙踪，耀芒青锋穗九龙。","璇玑不曾怜微影，怎料今生为情偿。","伍相祠堂杨柳垂，睿明今秋几世人？","江潮依旧年年过，难消当年忠心寒。"]},{"id":"qz1460736132","title":"寄相思","genre":"七言","date":"2016-04-16","volumeNo":2,"body":["玫瑰浮香心留味，","执手相伴有情痴。","何日重逢言欢乐，","今宵把酒寄相思。"]},{"id":"qz1460386640","title":"苏幕遮·春晓","genre":"词","date":"2016-04-11","volumeNo":2,"body":["昨夜风，","绿江东，","无限春光，","谁道花易老？","梦入相城寻芳草，","仙子如画，","轻叹相思缈。","","恰此时，","花正好，","只醉今朝，","闲愁君莫扰。","朱砂轻解伊人梦，","晓望春月，","怡然念七巧。"]},{"id":"qz1459501008","title":"若你没有离开我","genre":"古体","date":"2016-04-01","volumeNo":2,"body":["若你没有离开我我依旧会躺在你柔软的怀里","让清风吹拂下柳叶","亲吻我的脸颊","若你没有离开我","我仍然围绕在你多变的四季","为你增添欢声和笑语","若你没有离开我","我就不会千里送鹅毛般","跨越人海和高台","也不会烦恼两兆网的无奈","深夜的宁静","让我怀念东门甜甜的牛奶","怀念几公里外遗址上累累的白骨","怀念去上课路上五分钟的遐想","怀念昔日晋级白金的网吧","却唯独不怀念你","因为我遇到了她","你离开了我"]},{"id":"qz1461424426","title":"朱帘轻掩藏幽色","genre":"古体","date":"2016-03-12","volumeNo":2,"body":["朱帘轻掩藏幽色，","晓妆惜月弄花愁。","怡如春桃化粉黛，","美若芙蓉出水柔。"]},{"id":"qz1455543927","title":"临江仙·营中","genre":"词","date":"2016-02-15","volumeNo":2,"body":["北海连天浮云浅，","日暮谁寻踪迹。","携手共倚石栏上，","落霞平春色，","几度雁南飞。","","年少不知岁月愁，","莫叹春聚秋离。","青春怎因时光老，","结彩炊香落，","回眸故人归。"]},{"id":"qz1449766214","title":"前世","genre":"七言","date":"2015-12-11","volumeNo":2,"body":["奈何桥头孟婆汤，","奈何桥后人各方。","只缘命系三生石，","死后方知前世殇。"]},{"id":"qz1448214885","title":"临江仙·相思错","genre":"词","date":"2015-11-23","volumeNo":2,"body":["青火残灯印泪痕，","窗外风雨箫箫。","不知何夕秋风寒，","一夜枫林落，","满目莲花凋。","","多少深情付东流，","谁怜孤影飘摇。","三千弱水浮生梦，","若是相思错，","回首陌路遥。"]},{"id":"qz1447985233","title":"昨夜","genre":"古体","date":"2015-11-20","volumeNo":2,"body":["昨夜初雪昨夜融，","昨日爱情何时怜？","昨夜无声声自叹，","今夜无缘缘又消。"]},{"id":"qz1446100266","title":"班主任生日快乐","genre":"七言","date":"2015-10-29","volumeNo":2,"body":["谷中明月映佳人，","淑女长歌几度怜。","琴伴浮音飞花落，","老树新柳又一年。","师苑谁念旧温柔，","生入红尘寻梦缘。","日月轮回终有尽，","快揽笔墨记容颜，","乐带离声无憾言。"]},{"id":"qz1444325225","title":"陌伤","genre":"古体","date":"2015-10-09","volumeNo":2,"body":["红尘往事尽奢华，","一曲离殇徒悼怜。","六界无歌凭寂寞，","半扶箜篌也依然。"]},{"id":"qz1444325155","title":"花非花","genre":"古体","date":"2015-10-09","volumeNo":2,"body":["君恨喜鹊起，","君叹无牵挂。","若非踏白马，","莫笑花非花。"]},{"id":"qz1443110462","title":"月不明","genre":"古体","date":"2015-09-25","volumeNo":2,"body":["沧海无尽月，","望家一片天。","谁叹长情远，","取杯共断肠。"]},{"id":"qz1443110375","title":"浪淘沙·不念","genre":"词","date":"2015-09-24","volumeNo":2,"body":["回忆惊梦醒，","蓦感私凉，","深夜谁知昙花落。","轻风吹落枫林叶，","情折秋末。","潸然泪满面，","无处悼怜，","奈何桥下清水寒。","三生石消爱恨缘，","生死不见。"]},{"id":"qz1442929347","title":"绣眉鸟","genre":"古体","date":"2015-09-22","volumeNo":2,"body":["——————————一首民谣，","可惜没曲【原创：","梁辰】","枯叶将落的秋凉","别有用心","半声半语的歌谣","翻山越岭","青色的羽毛啊掉了吗","在你吵吵嚷嚷的早晨忘了青春","我在苍白无光的黄昏一言不语","可爱的姑娘啊","依旧在南方的田野里独自回家","人来人往的城市","无声无息","花草丛生的荒原","难分难舍","孤独的是谁的世界阿","他在兢兢业业的路上放声歌唱","我在忙忙碌碌的梦中寸步难行","迷茫的小鸟啊","依旧在南方的田野上徐徐飞行","谁在无所事事的家里轻轻呼唤","你在半生不死的远方泪流满面","姑娘啊我能陪你回家吗"]},{"id":"qz1426438348","title":"一剪梅·无归","genre":"词","date":"2015-03-16","volumeNo":2,"body":["稀兮春雨葬花雪，","未褪寒烟，","吹乱衣袖。","去年秋雁携轻愁，","人似过客，","缘断琴休。","","故亭新草无归迹，","残月空映，","灯烬天幽。","彼心若忘流年事，","清风折柳，","天涯陌路。"]},{"id":"qz1412354209","title":"苏幕遮·飘摇","genre":"词","date":"2014-10-04","volumeNo":2,"body":["暮夜舞，","月华怜。","旧时云浮，","青丝随风转。","百里诗情万里天，","谁叹飘摇，","回望长亭远。","","言风轻，","笑无缘。","何夕陌路，","寒霜冷牵绊。","柳念别情花倦落，","人若永安，","天涯莫相见。"]},{"id":"qz1409133538","title":"末夜","genre":"七言","date":"2014-08-27","volumeNo":2,"body":["秋风怜暮淡云霞，","柔光怡晴映月颊。","独倚末夜灯不烬，","恐入梦中又天涯。"]},{"id":"qz1396026416","title":"江城子","genre":"词","date":"2014-03-29","volumeNo":2,"body":["几年烟雨雁离处，","朝有霞，","暮成夕。","烟花易冷，","新气换旧云。","明月如钩钩不住，","青衣袂，","伊人影。","","好梦总有闲人睡，","不自量，","具成灰。","纤弱红尘，","断思难再续。","飞鸿又寄百合意，","无人喜，","无人恨。"]},{"id":"qz1392125723","title":"以我所爱，换你微笑","genre":"五言","date":"2014-02-11","volumeNo":2,"body":["在意那么多","还怎么生活","青春不浪漫","何时有烟花","允许你沉默","不是我个性","放飞的风铃","守候着星座","乐你所快乐","伤你所悲伤","天上的星空","闪闪的希望","脸上有笑容","生命有意义","用我的双袖","抹去你泪珠","天下有情人","大家在一起"]},{"id":"qz1391789565","title":"心的距离","genre":"五言","date":"2014-02-08","volumeNo":2,"body":["眼神的犹豫","是心的距离","清楚也模糊","彼岸如此遥远","明明爱可以在一起","却又相互抗拒","飘落吧","淡淡的玫瑰气息","让心灵紧握","十指相扣的温暖"]},{"id":"qz1389174651","title":"临江仙·冷雪","genre":"词","date":"2014-01-08","volumeNo":2,"body":["霜染砚石墨润湿，","诗题天涯挂牵。","冬风微寒青鸟稀，","孤雁无哀鸣，","落日有晴天。","","纷纷暮雨如思缕，","酒暖醉倚栏杆。","好梦忽醒留余味，","月浮瑶台处，","泪露并青衫。"]},{"id":"qz1387468531","title":"过错","genre":"五言","date":"2013-12-19","volumeNo":1,"body":["你走过江南","路过我身旁","我却以为","是昨夜的梦影","慰藉我心灵","错过","已是命中注定","想要证明","友情堪比天地","最后只是看着你","笑着说好像"]},{"id":"qz1387193820","title":"江城子·一世恨晚","genre":"词","date":"2013-12-16","volumeNo":1,"body":["断桥离情堪回首？","几度去，","几人逢。","冬雪秋尘，","四海太苍茫。","只影九州身尚好？","云端外，","月胧明。","","自古离愁宿命中，","聊无绪，","叹太平。","谁伴红装，","流萤绕梦梁。","城门车马渐消去，","风萧萧，","雨中殇。"]},{"id":"qz1385724266","title":"待我长发及腰","genre":"五言","date":"2013-11-29","volumeNo":1,"body":["【婉秋】","待我长发及腰，","公子归来可好？","山川渺渺望水迢迢，","独卧小楼，","懒着红妆浅笑。","拨弦琵琶绕，","隔声夜雨飘摇。","画舫听梦胧明，","晨光熹微破晓。","古词诗卷留香，","墨染梅花妖娆。","待君明日归来，","共把诗篇细嚼。","【良辰】","待卿长发及腰，","归途尚未有期。","孤雁凄凄鸿信痴痴，","徘徊亭中，","恐负幽幽相思。","十年寒窗梦，","于今还盼卿知。","婉辞只因情深，","秋风不乱青丝。","朝暮满楼书声，","功名还差一夕。","明年桂花落时，","中秋仰月相依。","2013年10月19号","【良辰婉秋】","锦瑟古风"]},{"id":"qz1385308018","title":"一剪梅·两处江湖","genre":"词","date":"2013-11-24","volumeNo":1,"body":["年年月望云散兮？","余晖天半，","却是虚无。","红尘陌路客当归？","秋霜尽染，","孤庭寒柳。","","临酒醉闻悦无情，","亭外人家，","舞毕叹休。","弹指岁月成古事，","一步天涯，","两处江湖。"]},{"id":"qz1382504817","title":"一辈子都会看不到的东西","genre":"古体","date":"2013-10-23","volumeNo":1,"body":["1.","这是马来西亚小镇Sema一群划舟的孩子，","像是在天空游荡。","2、美国50号公路被称为“全美最孤独的公路。","3、加拿大不列颠哥伦比亚省温哥华的卡普兰奴吊桥：","4、迪拜多云的一天：","5、日本富士山海边的荧光乌贼：","不得不说真的很漂亮","6、佩拉杰群岛（PelagieIslands）位于地中海中部，","海水透明得宛如船漂浮在蓝天上","这个美，","动人心魄……：","7、阿尔卑斯山脉下面：","8、智利的冰川：","9、新疆伊犁，","像是梦中的世界：","10、罗马尼亚的瀑布你能想象这是真实的景象，","而不是ps作品吗？","11、迪拜的海底世界：","11、你能猜出这是海水吗？","跟果冻一样。","班赛岛的水晶海浪：","12、吉兰格峡湾：","13、海滩，","赖阿特亚岛-法属波利尼西亚天空之海啊！","14、玻利维亚的乌尤尼盐沼.","一个犹如梦境的地方我就不说这种地方吊丝只有梦里才能见到！","15、摄影师拍到通往银河系的星路：","16、西班牙老图书馆：","17冰岛的蓝冰冻，","如果在里面做冰镇西瓜，","也许十秒后就得用锤子敲了！","18哥伦比亚大教堂：","19马尔代夫：","20天堂？","21九寨沟：","（拍神雕侠侣的地方）","22乌克兰某个火车隧道：","23拉普兰世界闻名的圣诞老人的故乡"]},{"id":"qz1382452655","title":"苏慕遮·暮夜流萤","genre":"古体","date":"2013-10-22","volumeNo":1,"body":["晚来时，","吹柳处。","月下幽幽，","彼岸微香暮。","湖面流萤暇如玉，","依依飘浮，","翩然随风去。","","轻舟畔，","客归路。","断言难续，","犹未把心诉。","山东明月可相似？","遥寄离绪，","何时卿回渡。"]},{"id":"qz1380125276","title":"苏幕遮·少年行","genre":"词","date":"2013-09-26","volumeNo":1,"body":["汗牛栋，","苦窗行，","窗外花草，","年年为谁好。","少年莫谈春风晓，","穷尽心智，","还未知芳草。","","一朝晨，","一夕霞，","缥缈如幻，","不为浮云扰。","君子此时忘相思，","漫漫路长，","怎为伊人恼。"]},{"id":"qz1378878024","title":"浪淘沙·叹逍遥","genre":"词","date":"2013-09-11","volumeNo":1,"body":["白鹭绕黄昏，","我自逍遥，","看尽江天落雁霞。","待得影淡乘风去，","轻羽不达。","","好景转头消，","明月柳梢，","孤星伴我夜更佳。","酒饮十千步平升，","梦入谁家。"]},{"id":"qz1376442255","title":"雨落七夕","genre":"五言","date":"2013-08-14","volumeNo":1,"body":["天外悟黄昏，","雨下叹七夕。","风迷鹊桥路，","楼中盼云稀。"]},{"id":"qz1376058211","title":"花枝","genre":"古体","date":"2013-08-09","volumeNo":1,"body":["秋有明月花有枝,","花枝明月不可依。","日暮风尘云遮蔽,","花枝不见惹相思。"]},{"id":"qz1374758459","title":"七月二十五日怀故人","genre":"七言","date":"2013-07-25","volumeNo":1,"body":["不恨昔雁远天去，","却怨引君渡青舟。","此时七夕已相近，","谁与烟花上西楼。"]},{"id":"qz1373891710","title":"阮郎归·知情","genre":"词","date":"2013-07-15","volumeNo":1,"body":["仲夏残阳如秋画，","已描离别悲。","红日蒸起云千浪，","愿伴落霞飞。","风渐寒，","夜偏晚，","默默盼早归。","咫尺一瞬即天涯，","相思为谁挥？"]},{"id":"qz1372515949","title":"江城子·十年不忘","genre":"词","date":"2013-06-29","volumeNo":1,"body":["几度回眸月已偏，","夜无数，","怎难眠。","无奈独饮，","酒洒花败残。","醉醒入梦却凭栏，","望江波，","烟水寒。","","谁对红颜无衷情，","六界空，","亦犹然。","幽幽箜篌，","符韵作缠绵。","一朝离去曲成殇，","音消处，","让人怜。"]},{"id":"qz1369552166","title":"玉影","genre":"古体","date":"2013-05-26","volumeNo":1,"body":["秋月知人意，东风误人情。","此心随风去，伴引雁孤行。","衡阳声何叹，北冥玉疏影。","谁结当归饮，相顾忘长亭。"]},{"id":"qz1368327968","title":"钗头凤","genre":"古体","date":"2013-05-12","volumeNo":1,"body":["枫散落，","燕离归，","明月春秋人尽待。","感初遇，","叹离殇，","玉系尘中，","花落人意。","忆！","忆！","忆！","云有泪，","洒芭蕉，","天亦有情诉相思。","倚栏上，","笑颜轻，","聆听雨声，","滴下无息。","惜！","惜！","惜！"]},{"id":"qz1366387009","title":"星恋","genre":"五言","date":"2013-04-19","volumeNo":1,"body":["沉静刻画你的心","飘逸描绘我的情","我们相邻一起","迷幻也真实","原本不应相识","原本不会相知","却因我的疲惫","眷恋你的温柔","哪次我们相望","那晚我们相约","明年过后","我们难再相见","相伴的无缘","相守的无心","我对你的爱","你我看不见"]},{"id":"qz1363444623","title":"临江仙·莲锁心巅","genre":"词","date":"2013-03-16","volumeNo":1,"body":["一念流年去如烟，","碧落黄泉深渊。","清莲朵朵含羞怯，","待到花开日，","时境已变迁。","","心随花落不惜缘，","无情最是摧残。","终是难言苦衷处，","淡淡相思远，","人与月长眠。"]},{"id":"qz1362196470","title":"落红叙","genre":"古体","date":"2013-03-02","volumeNo":1,"body":["红尘晚，","静夜阑，","漫天萤光，","烛火微燃。","噫笑中，","对酒当诗，","墨色迷离，","清水映可怜。","说再见，","徒惋惜，","霜雪不归，","曲毕君遣。","知心念，","痴恋尘缘，","相思无期，","何人伴身边。","当年亭外几回牵手，","罗裙舞弄几轮明月。","鸿书难休，","只盼此情此景永不绝。","终难忘，","与你唱挽歌。","情难尽，","情难牵，","昔日柳下，","泪洒心间。","末路花，","纷落归尘，","故道西风，","离绪怎吹散。","当年亭外几回牵手，","罗裙舞弄几轮明月。","鸿书难休，","只盼此情此景永不绝。","终难忘，","与你唱挽歌。","清浪伏幽寒，","伊人相望，","天涯两隔。","明月依稀照，","欲语仍记旧时约。","原曲：","皋兰山月"]},{"id":"qz1360336681","title":"浪淘沙·赠良辰","genre":"词","date":"2013-02-08","volumeNo":1,"body":["晓风惜红叶，","微光朦胧，","岸边杨柳话语柔。","无觅源头水长流，","携手同游。","","春色溢满园，","月色玲珑，","无奈人去也匆匆，","自是人生不由己，","怎解千愁？"]},{"id":"qz1358609351","title":"一剪梅","genre":"词","date":"2013-01-19","volumeNo":1,"body":["夜深入梦人独影，","梦里不知，","伊人何处。","日月难缠情似幻，","恐怕离别，","相思几度。","","常念夕下伴罗绮，","舞转香飘，","清风秋暮。","唯盼春雨散桃花，","燕子归巢，","兰舟回渡。"]},{"id":"qz1358153661","title":"时空","genre":"七言","date":"2013-01-14","volumeNo":1,"body":["日落红尘月无踪，","小弹琵琶卧水中。","梦入儿时邀相戏，","共与清宵叹时空。"]},{"id":"qz1357112990","title":"苏幕遮·过往今惜","genre":"词","date":"2012-12-20","volumeNo":1,"body":["万寂空，","醉花烟，","遥望窗边，","人心一片天。","秋月此时手相牵，","即使过往，","天长情不淡。","","心有念，","思无量，","雨打枝头，","落英耐冬眠。","忽见阳光漫云间，","西楼隔断，","温暖临清轩。"]},{"id":"qz1357112917","title":"私幽","genre":"古体","date":"2012-12-19","volumeNo":1,"body":["昨夜星辰中，月弯如轻舟。","寥寥寂长空，渺渺映水洲。","沙鸥不觉惊，私下语清幽。","流萤似识声，飞照影悠悠。"]},{"id":"qz1357112863","title":"卜算子","genre":"词","date":"2012-12-18","volumeNo":1,"body":["云乱清音弄，","黄昏不饶情，","落日消散月消沉，","倒影碧空长。","","暗语随天荡，","万里是愁肠，","泪落无痕燕归惆，","欲述何人听。"]},{"id":"qz1357112834","title":"采桑子","genre":"词","date":"2012-12-17","volumeNo":1,"body":["韶华不留年少事，","归弃鸿书，","归弃鸿书，","多少柔情随它去。","","酒自独饮人自悦，","西江月暮，","西江月暮，","凭他只醉春江玉。"]},{"id":"qz1357112792","title":"盼相思","genre":"古体","date":"2012-12-16","volumeNo":1,"body":["柳条自断归江岸，烟水寒舟望花枝。","二十四萧声长逝，问人何处鸣秋心。","举杯成空水自醉，月影无边泪许诗。","今日明日不再见，来年几时盼相思。"]},{"id":"qz1357112744","title":"采桑子 来年相逢","genre":"词","date":"2012-12-15","volumeNo":1,"body":["竖笛声变情奏快，","怠慢秋尘。","为谁欢悦，","来年相逢扫星辰。","","红云横天枝叶燃，","落花无痕。","不知所谓，","春桃夏莲许她人。"]},{"id":"qz1357112708","title":"临江仙·梦","genre":"词","date":"2012-12-14","volumeNo":1,"body":["忽临静湖水横清，","倩影相邀彼岸。","短曲折尽柳条新，","清声与玉露，","且待共桃花。","","日月轮回九更情，","幽梦迷糊未察。","万劫无期凭谁念，","天地缠成线，","信手隔天涯。"]},{"id":"qz1357112617","title":"苏幕遮 春盼","genre":"词","date":"2012-12-13","volumeNo":1,"body":["笑青霞，","万里红，","凭栏高处，","悠然似昔时。","携手流云入海楼，","轻渡飞舟，","飘摇入伊怀。","","临江羡，","欢喜中，","多少私心，","流露对枕席。","一缕暗香随暖风，","烟花三月，","独自吹玉笛。"]},{"id":"qz1357112579","title":"点绛唇 别后","genre":"词","date":"2012-12-12","volumeNo":1,"body":["分送阳关，","良辰美景太匆匆。","别过柳中，","萦绕花雨从。","孰知过后，","是相思几重。","酒意浓，","醉眼朦胧，","不见归影踪。"]},{"id":"qz1357112538","title":"浪淘沙","genre":"词","date":"2012-12-11","volumeNo":1,"body":["青柳随尘埃，","尤记当初，","游云伞转雨羞朦。","楼檐知心默含情，","不知所踪。","","多少人事空，","小雨私秋，","情到深处情痴狂。","山花依旧书信中，","谈笑轻鸿。"]},{"id":"qz1354705187","title":"苍天","genre":"七言","date":"2012-12-05","volumeNo":1,"body":["梦里花落不知秋，红尘依旧还温柔。","苍天不过一场雾，举醉天下何必休？","若问韶华多伤事，我自游云扶袖去。","往事浮华难尽意，还待二月来再续。"]},{"id":"qz1357112501","title":"钗头凤·等待","genre":"古体","date":"2012-12-01","volumeNo":1,"body":["风颜过，","花千开，","醉里迷茫一场欢。","问流年，","怎留念，","千古雅风，","半展红颜。","怨！","怨！","怨！","","待回首，","情相牵，","梦里萦绕山水间。","旧时缘，","尤伤感，","日落云散，","无人陪伴。","叹！","叹！","叹！"]},{"id":"qz1357112451","title":"误佳期·问情","genre":"五言","date":"2012-11-30","volumeNo":1,"body":["相思难眠秋梦，","等待怕误佳期。","灯火处处迷心雾，","还盼旧雨时。","","举杯忘归路，","执笔欲问情，","纵使思念千百首，","真意只一字。"]},{"id":"qz1354112467","title":"西江月·芜晴","genre":"词","date":"2012-11-28","volumeNo":1,"body":["小雨伴有新春，","冷夜常叹无晴。","枫叶残断秋吹过，","醒时水凝风冻。","","天涯相逢难问，","别时曲短情长。","私里心痛竟不察，","清晓悠悠谁共？"]},{"id":"qz1354112123","title":"钗头凤·相见难","genre":"古体","date":"2012-11-28","volumeNo":1,"body":["古道远，","离人悴，","半卷黄沙思飞燕。","怎回首，","送长亭，","旧地凄凉，","残影阑珊。","念！","念！","念！","","相见难，","思幽长，","风急萦纡绕天寒。","问何时，","手相执，","游云路雨，","步入红尘。","缠！","缠！","缠！"]},{"id":"qz1353077462","title":"画堂春","genre":"古体","date":"2012-11-16","volumeNo":1,"body":["秋里识春一画堂,","百般倾诉愁肠。","举杯饮月问路长,","欲往何方。","解语幽情自掩,","举目私心难藏。","青柳枯黄雨茫茫,","雁落几行。"]},{"id":"qz1353077151","title":"神仙","genre":"七言","date":"2012-11-16","volumeNo":1,"body":["系剑游仙云飘渺，","瑶台歌舞醉无语。","年年秋风吟明月，","徒羡人间交杯酒。"]},{"id":"qz1352992537","title":"长相思","genre":"词","date":"2012-11-15","volumeNo":1,"body":["花飘坠，","雨飘坠，","收尽金风青花翠，","举伞他人醉。","","笑迷离，","眼迷离，","秋叶无丝秋月瓷，","玉水明乐琪。"]},{"id":"qz1352908149","title":"江城子·怀念","genre":"词","date":"2012-11-14","volumeNo":1,"body":["初冬深夜寂无眠，","遇梦中，","叹缘浅。","九曲剑断，","惆怅斯人远。","纵使红尘醉潇洒，","幽静时，","心犹感。","","楼垣昏明灯几盏，","徒追念，","拜别短。","枫满长亭，","鸦鹊归巢晚。","遥望竹林卧西场，","试逐月，","映人脸。"]},{"id":"qz1352641992","title":"浪淘沙·离人叹","genre":"词","date":"2012-11-11","volumeNo":1,"body":["天乱心不安，","欲语还休，","几缕寒风衣角边。","凝视故道草渐生，","离人空叹。","","回望青丝断，","挽歌难唱，","相知相伴终成憾。","字字缠绵诗犹淡，","不止分散。"]},{"id":"qz1352639932","title":"阮郎归 思念","genre":"词","date":"2012-11-11","volumeNo":1,"body":["往昔烟花惹怜人，","花前忘牵手。","前殇旧怨了忧愁，","如今盼回头。","萧古风，","落新雨，","碧空望重楼。","长梦幽缘月单影，","孤寂为厮守。"]},{"id":"qz1352383350","title":"苏幕遮 · 枫情","genre":"词","date":"2012-11-08","volumeNo":1,"body":["落红残，","送君远。","此去华年，","别后知遥远。","怎奈大雁争北往，","春秋迷愿，","百般怨栏浅。","","秋子意，","云雨间。","长恨多情，","终难挽归遣。","泪眼常随风作雨，","空叹思念，","飞落无人拈。"]},{"id":"qz1351093814","title":"昼夜乐·明夕何夕","genre":"古体","date":"2012-10-24","volumeNo":1,"body":["乌啼月落西帘上，","伊人去，","秋色暮。","怎知香飘几里，","静花迷艳飞狐。","只是无声离别绪，","红尘误，","相思难住。","挑尽孤灯明，","忧然叹空付。","","星辰轮回今年逝，","尤茫然，","七夕聚。","奈何不见朝暮，","方解情深如许。","万缕千丝系云舟，","游天涯，","人间何处。","待再忆芳容，","浑然不知数。"]},{"id":"qz1349865894","title":"紫漱","genre":"七言","date":"2012-10-10","volumeNo":1,"body":["紫漱轻飘吹凤语，","粉衣淡妆笑靥甜。","谁记五更来幽处，","转把愁思舞婀娜。"]},{"id":"qz1349865654","title":"江城子","genre":"词","date":"2012-10-10","volumeNo":1,"body":["月色照影影渐长，","斯人韵，","来入梦。","寻欢归去，","方知相思烬。","心结百结凭谁断，","系青舟，","踏桥鹊。","","倚栏思君君无望，","月下约，","又何是。","倾生相盼，","唯有梦生寒。","惹尽暮夜黎明后，","冷秋风，","寒袖衫。"]},{"id":"qz1348931289","title":"渔家傲·月舞","genre":"词","date":"2012-09-29","volumeNo":1,"body":["昨日月消今夜圆，","庭月满霜伊人前，","难耐暗香树娑影，","风荡漾，","玉夕罗裙轻飘转。","瑶宫寂酒难消遣，","为谁常伴仙人舞，","云绕桃花花泪短，","烟弥漫，","季雨流光凭谁掩。"]},{"id":"qz1348379892","title":"浪淘沙·菱梦","genre":"词","date":"2012-09-23","volumeNo":1,"body":["深梦恨难分，","晓夜阑珊，","苦杯无处搁心事。","本是姻缘天散去，","菱香飘逝。","","璃歌何处唱，","柳树妖娆，","当年玉腰事闺秘。","谁料百年迷情泪，","青冢轻泣。"]},{"id":"qz1348227318","title":"苏暮遮·少年情","genre":"古体","date":"2012-09-21","volumeNo":1,"body":["春易瞑，","秋难逝，","满园残柳，","提笔思飞绪。","谁言年少不知愁，","几年离索，","音韵已模糊。","","忆往昔，","情眷恋，","记月尤如，","乘风来相遇。","落红拾尽花依旧，","故颜秋雨，","谁为相思许？"]},{"id":"qz1346253562","title":"钗头凤","genre":"古体","date":"2012-08-29","volumeNo":1,"body":["玉水溪，","红尘路，","北风常临遣人归。","人离前，","景沧茫，","化作西风，","与君常醉。","谁？","谁？","谁？","愁云重，","笑言轻，","孤星半掩月色飞。","寒空破，","泪无常，","何尝仙酒，","指月当杯。","醉！","醉！","醉！"]},{"id":"qz1345909776","title":"钗头凤·情断","genre":"古体","date":"2012-08-25","volumeNo":1,"body":["今年冷，","西风旧，","回首相见泪无处。","一身情，","终被拒，","只望他人，","谈笑无数。","妒！","妒！","妒！","","黎晨梦，","欢时薄，","心中只道身如故。","昔人意，","难再叙，","秋月来风，","己成陌路。","不！","不！","不！"]},{"id":"qz1345735824","title":"浪淘沙·念八月十六车站逢君","genre":"词","date":"2012-08-23","volumeNo":1,"body":["明月还照落，","青云晚来，","今夕多少忆过往。","人间何处不相逢，","冥冥终定。","","天鸣撩天寒，","何处凭栏，","无限相思惹悲景。","不是桃源不见君，","曲短情长。"]},{"id":"qz1345723369","title":"七夕","genre":"古体","date":"2012-08-23","volumeNo":1,"body":["朝朝暮暮伊人在，","年年月月七夕同。","昔日不敢来相告，","今夜有勇求携手？"]},{"id":"qz1345298672","title":"一剪梅·台风","genre":"词","date":"2012-08-18","volumeNo":1,"body":["路人言短行匆匆，","举伞欲赠。","已成悔事。","不认狂风卷情去，","雷霆易逝，","雨过云舒。","","相见还是相思好？","徒解多情，","难知真意。","盈盈水流月明里，","人去天寒，","短纱谁织。"]},{"id":"qz1343315204","title":"惜分飞·忆如","genre":"古体","date":"2012-07-26","volumeNo":1,"body":["断梦行歌花草去，","相复迢迢几度。","两心题一处，","情短恨长无归路。","","暮夜纷纷天情雨，","总把相思难住。","不悔昔轻触，","一曲春绪风留驻。"]},{"id":"qz1342765690","title":"消失的时光","genre":"古体","date":"2012-07-20","volumeNo":1,"body":["消失的时光","完全沉默在心中焕发","天注定了一个人走","道路野花开得芬芳","我听有人说","路边蝴蝶并肩走过田野山村","她说","化身的梁祝是路边的蝴蝶","萦绕在身旁","满满的爱似昙花一现","天注定了一个人走","离开天明的等待","回忆在路上走的好慢好慢","不再有人问","化身的梁祝是路边的蝴蝶","不再有人说","路边的爱情肩并着肩","甜美洒落","带走紫星如梦","一页页锁住了感觉","踏着歌谣无数"]},{"id":"qz1341143186","title":"无计留春","genre":"七言","date":"2012-07-01","volumeNo":1,"body":["晨露有意留春住，","夜雨无心落叶声。","回首逢君惜末路，","只是偏月正浅影。"]},{"id":"qz1340809028","title":"昼夜乐·静夜思珍","genre":"古体","date":"2012-06-27","volumeNo":1,"body":["飞蓬飘絮牵尘世，","初画眉，","挂青衫。","淡装别有滋味，","眼眸偷藏脂烟。","思无量，","一响贪欢。","相见不相误，","此情为红颜。","春秋不老年华事，","思无处，","惜情缘。","鸿雁凄凄无计，","梦里哪般凭栏。","寻觅百家影渐疏，","初尝愁，","难记容颜。","只影向人间，","生死来探看！"]},{"id":"qz1340452115","title":"浪淘沙·思燕","genre":"词","date":"2012-06-23","volumeNo":1,"body":["西风醉长天，","花叶横斜，","曾经几时轻舞裙？","昔日美景今夕是，","满目浮云。","","笑恨天涯远，","青丝弄长，","人间何处能逢君？","思绪飞落无人拈，","独走黄昏。"]},{"id":"qz1340291518","title":"让爱在心间","genre":"古体","date":"2012-06-21","volumeNo":1,"body":["在没有爱的心中","燕子也孤寂交往","只有风雨在凝噎","俯视着大地苍茫","影婆裟了仲夏的叶子","沙沙声、回味淡淡菱香","爱即使遥远","也就远着了千百度的风殇","没线的纸鸢","浮沉美好的告白","幽静的方式","清新释怀","扫尽心中的尘灰","心境自然优美","钟声敲碎了时间","故事成为传说","谁又舍得那天？","最美的一天，","让爱在心间。","后来如何伤人","是了就是了","无法改变","多少人、多少事，","爱在心间","一笑坦然"]},{"id":"qz1339582676","title":"怎缺那份宁静","genre":"古体","date":"2012-06-13","volumeNo":1,"body":["心弦","悄悄落下","谁又回眸一指","惹起思绪飞然","场景","总能让人想太多","想拥有的宁静","却又只能收藏"]},{"id":"qz1338563258","title":"换巢鸾凤","genre":"古体","date":"2012-06-01","volumeNo":1,"body":["仙境迢迢，","惆怅深情长。","天蚀人愿，","放眼难觅旧衣，","百年了还新冢。","云天星河自归处，","尤似人间，","换巢鸾凤。","曾经是，","那年那伊踏青山。","青鸾，","菱香淡。","小笑故人，","怎堪轻水流。","石沉悉洞，","洞悉尘世，","依旧物是人非。","谁恨前尘空繁华，","徒留白年后凝咽。","惜情散，","又见玉水涣红装。"]},{"id":"qz1337267521","title":"勇气","genre":"五言","date":"2012-05-17","volumeNo":1,"body":["把忧伤放下","勇敢笑起来","别害怕交往","其实没那么复杂","坦率笑一笑","让花儿也高兴","把忧伤卸下来","离来只为了更强"]},{"id":"qz1337267171","title":"阮郎归·如意","genre":"词","date":"2012-05-17","volumeNo":1,"body":["锦绣年华心难悦，","执手留初忆。","卸愁行舟轻流动，","游去悲伤事。","心如意，","情如意。","事事难如意。","韶华尘间一沉浮，","只若茶香沏。"]},{"id":"qz1336745252","title":"规言","genre":"五言","date":"2012-05-11","volumeNo":1,"body":["回首望断，一岁一朝夕，","长亭连短亭。莫道离情苦，","相见勿寡言，今夕有欢颜。"]},{"id":"qz1336742428","title":"忆王蓬絮","genre":"古体","date":"2012-05-11","volumeNo":1,"body":["望伊，","心自悦。","蓬絮正飞，","小桃初形。","梦里欢谈心浅藏，","蜀中花圃坠思聆。","酒洒泪痴心，","红情沾青石。"]},{"id":"qz1336734336","title":"夏闻","genre":"五言","date":"2012-05-11","volumeNo":1,"body":["春叶初长成，","仲夏有新诠。","蝶恋月舞曲，","彩翼绕花间。"]},{"id":"qz1336706311","title":"红杏含笑","genre":"七言","date":"2012-05-11","volumeNo":1,"body":["青叶碧凝，晓思春浓。","红杏含笑，舒望何人？","轻沏倩影，暗香浮动。","风摇絮飘，笑语芳踪。"]},{"id":"qz1336653091","title":"微笑","genre":"古体","date":"2012-05-10","volumeNo":1,"body":["在风中","感受到了你的微笑","在雨中","聆听到了你的微笑","单纯的笑","像潭清水、清丽秀美","我开始徘徊","是你改变了我","还是微笑改变了我"]},{"id":"qz1336493381","title":"回忆","genre":"古体","date":"2012-05-09","volumeNo":1,"body":["我叮嘱你的","你说不会遗忘","你告诉我的","我也全部珍藏","对于我们来说","记忆是飘不落的","永远也不会发黄","我们天各一方","默默的回想那些流逝的美好时辰","也许我们会重逢","那时","但愿我能在岁月的皱折中","发现一双","曾经的眼睛","或许曾经哭天地繁华","或许曾经舞我们爱情","用心聆听黄昏的海口","寂寞之时","你就会聆听到我的声音","一直一直都在你的身边停驻","在人生的道路与你不期而遇","是我这生中最幸福的时光","在众多缤纷的光影中","我找到属于我们的主旋律","同为我们的未来而歌唱","在人生的画卷中","曾有同属于我们的印记","时光是不停歇的小溪","让我们同坐岸边静听他的流逝","愿我的心意","抹去你的忧伤","愿你的肩膀","带给我的依靠","曾为我们的未来做畅想","那是一场美梦","或许很多年后","我们还可以回忆曾经走过的路","苦乐在岁月中蒸发","留下最美的色彩","五彩斑斓"]},{"id":"qz1336493306","title":"飘落","genre":"古体","date":"2012-05-09","volumeNo":1,"body":["情意如同蝶叶凋零","秋天","枫叶似淑女般抹如红妆","在我的世界献媚","打开内心天堂","曾经印有的尘迹","再次抹上尘埃","泪水如同奔流的小溪","一层一层把尘迹冲洗","或许不该存有幻想","或许该把不该存在的记忆抹去","会对自己说","没有曾经的故事","自己同样会活得更好","蝶叶再次展现飘落","轻轻飘落在人间净土","缓缓的滴在上山小路","寂静空间","时间的喧哗已成过去","蝶轻落树梢","花现落轻土","鸟啼萦耳绕","尘中记忆的呼唤","哭泣过去的拥有","双手没有温暖","泪以融入这风景","脚步踏响地上落叶","隔离世间的人间天堂","外界停却侵扰","紧闭双目","找到属于世界寂静的主旋律","听","心灵荡漾了","轻轻吹来的微风打在发梢","那飘落的红叶随即旋舞在天际","慢慢的","落在掌心","尘世间的琐碎没有把他憔悴","晶莹闪烁的珠衬托红般耀眼","内心震动","突然明白","记忆是躲闪不了的","恍若世界丢下了我","飘落","飘起我的记忆","终于","打开内心世界","记忆","永远是可贵美丽的","无可替代的生命般","尽管生活不尽如意","或许曾经牵绊","可换另一角度去拥抱","我们世界还是充满快乐","飘落","不代表永远的失去","蝶叶再次飘落旋即苍穹"]},{"id":"qz1336288877","title":"陌路花","genre":"古体","date":"2012-05-06","volumeNo":1,"body":["路边的陌路花","正开得浪漫、","离人的眼泪","思念得忧伤","花谢花开，","辗转多少轮回。","望远边的小楼","想过去的事情","哪年？","谁在细数这陌路花","一片...","两片..","还记得吗’","在灯下","细谈着诗书琴画","在楼中","指着远处的群虹广霞","百年之后，","奈何桥下..","还能执手相顾无言吗？","陌路花","飘逸着思念、","我依然在这","细数着一片..","两片.","今年花开得灿烂","你还会回来吗","想你","好久、好久","一切都散了吧","说好了’","再见","但结局总是","再也不见..."]},{"id":"qz1334231106","title":"望仙","genre":"古体","date":"2012-04-12","volumeNo":1,"body":["金矫藏玉美，","玉水透明沙。","枫叶踏白鹤，","流霞浮云舟。"]},{"id":"qz1330847796","title":"醉阴花·红颜迷路","genre":"五言","date":"2012-03-02","volumeNo":1,"body":["繁华流年愁几处，","翘望人归路。","晓灯迷糊涂，","寥寥千百度。","罗裙难觅旧时舞，","私语无人述。","晚鸦追夜暮，","星沉月浮，","情了红颜枯。"]},{"id":"qz1330847732","title":"误佳期","genre":"五言","date":"2012-02-29","volumeNo":1,"body":["初识愁肠滋味，千金难买一笑。","春到天涯旧相识，不愿称子老。","又愿称子老，携手流年晓。","只念无意误芳草，但惜情难了。"]},{"id":"qz1330847638","title":"御街行·忆龙葵","genre":"词","date":"2012-02-28","volumeNo":1,"body":["舍去轮回为剑灵，","梦初醒，","千年叹。","依念前尘血脉情，","苦了闺阁深院。","眷恋人间，","懵懂今生，","犹似续前缘。","","扶娇怨藏无一字，","回魂梦，","泪空传。","广袖流仙伴凄凉，","剑冢离愁又燃。","小隐古镇，","笑靥青裙，","草色复春颜。"]},{"id":"qz1330236595","title":"仙剑3之龙葵诗","genre":"古体","date":"2012-02-26","volumeNo":1,"body":["一剪梅·寥落风","大梦初醒已千年","凌乱罗衫","料峭风寒","放眼难觅旧衣宽","疑真疑幻","如梦如烟","看朱成碧心迷乱","莫问生前","但惜因缘","魂无归处为情牵","贪恋人间","不羡神仙","御街行·失魂雨","纷纷雪落人飘坠","同死生","共玉碎","前尘后世君莫问","柔肠百结如醉","情丝未断","尘缘难了","萦绕千千岁","舍却残生犹不悔","身已空","尽成泪","路长梦短无寻处","总是情愁滋味","眉间心上","柔肠百结","尽付东流水","阮郎归·龙葵结局","临流揽镜曳双魂","落红逐青裙","依稀往梦幻如真","泪湿千里云","风骤暖","草渐新","年年秋复春","闻香软玉燕依人"]},{"id":"qz1330240677","title":"一剪梅·竹梅","genre":"词","date":"2012-02-23","volumeNo":1,"body":["夕时巧遇叶烛边，","朦胧细眼，","羞掩青丝。","明月羁伴送河岸，","笑意柳中，","行礼分离。","","春香翠美散天星，","轻拂罗绮，","似柳似伊。","风穿细竹黑影间，","手剪梅花，","遥岸单思。"]},{"id":"qz1330847562","title":"阮郎归·琉璃月","genre":"词","date":"2012-02-17","volumeNo":1,"body":["琉璃晓月柳泪云，","惆怅燕追人。","千年萦纡断人间，","凄凉扰红尘。","雪见暖，","雨渐稀，","年年旧怨新。","仍记别离烟雨梦，","风残柳下人。"]},{"id":"qz1330240279","title":"诉衷情·同弦曲","genre":"词","date":"2012-02-13","volumeNo":1,"body":["闲情浮诗因相识，","素手织殷勤。","仍故墨颜迁离，","旧梦空，","彼岸频。","风离迷，","念昔谣，","似伊临。","追忆又拾，","曲散花笛，","愿意无垠。"]},{"id":"qz1325569648","title":"飞雪识霜","genre":"古体","date":"2012-01-03","volumeNo":1,"body":["尤记那年雪飞灵，","秋风北去留飘零，","窗外飞雪，","梦中只待见谁。","临寒纱纱若青影，","想念不知何相遇，","留梦红尘，","风烟不吹三柳。","笛儿声声轻风起，","思绪缭乱怎懵懂，","雪花飘零，","飘落了相思意。","前世今生还待续，","杜鹃轻唤鸳鸯叙，","花落谁知，","满地是殇情。","潇潇雨歇，","滴出三生，","初春红豆初芽。","冰雪融，","屋前谁在叹息。","容颜难消，","千年之后，","风沙刮乱坟碑。","今生遇，","初逢霜降天地。","忘了今生来相遇，","怎记红豆葬生死。","仙剑梦长，","何奈女儿相恋。","红线轻巧弄思意，","双玉凝碧问苍生，","寥落人间，","鸿雁几时起。","昔日不识，","沉落时节，","未能共与伊识。","难再想，","爱恨只在一间。","连理比翼，","梧桐松柏，","奈何心稀繁华。","朱华装，","谁裹红纱两清霜。","花落花笑花痴狂，","一生一世一飞剑。","不堪往世，","卿卿多少唔语。","三生穿梭三须臾，","六道轮回似意途。","灵珠有泪，","几世思牵缘。"]},{"id":"qz1324796671","title":"忘别千年","genre":"古体","date":"2011-12-19","volumeNo":1,"body":["凭怜阑阑烽火天，","梦中迷离疑孤单。","不忍一梦双影伴，","难忘已是陌路前。","天坠，","容颜千年。","望伊，","已成往年。","碧炉炼，","风雨歇。","冥冥中，","若是心怯。","谁护暖松，","怜敏花思歇。","轮回间，","冬至今宵。","问，","谁道沧桑古天。","蓝月间，","人生划梦若一天。","戚戚，","风岚宿命。","誓言彼岸，","相怨人间。","若离去，","直言相弃又何妨。","尤记昔月，","君已不见。","只留龙葵寻红葵，","一梦期间双影心。","谁见，","泪落脸旁。","红魅怎寻得，","蓝影碧泪凝。","不忍，","那伊那人相伴去。","遥借龙葵一叹，","梦只是前生。","明月双双微星契，","寥寂昨夜梦回天。","尤记那些，","爱似姊情，","徒感流连。","又惜多少，","明日应当遗忘，","留情风烟水灵灵。","悠悠","魔剑铸入思兄情怨，","锁妖塔中深叹连连。","可曾记得那满庭葵花，","何时才能重逢晴天。","不论前世今生来言，","宁愿只怜倾刻相见。","千载惟愿来一相逢，","不求君能相怜祈愿。","月斜江春，","星辰微亮斑斓几点。","塔中积怨，","问人间兄何在耶？","想念哪天，","君归扶微微。","但伊背离去，","孤单心自安。","千年轮回还是离别，","望穿三世不见君归，","缓缓情暖，","别忘难成更是忧伤。","龙葵寻兄，","千古只缘再铸情中，","待到万年只是梦间。"]},{"id":"qz1322375738","title":"若相惜","genre":"古体","date":"2011-11-25","volumeNo":1,"body":["寒花霜露舍莺燕，冬雪秋月弃辰星。","往世尘埃多粒子，影扶泪眼混不清。","天仙雨雾轻飞落，流萤飘梦坠瑶城。","风急艳云余晖散，蒲包薄荷紫霞烟。","松柏阑灯闻私语，玫瑰微芬化土香。","蝶恋双双思夜暮，人情对对意黄昏。","伯英日残千柳泪，鸳鸯月圆百合欢。","不是有情失愉乐，又是无情日消落。","把持亲爱生光亮，遗弃人心尽天暗。","花雪星月霜莺燕，有情私意思倾散。"]},{"id":"qz1321156872","title":"念奴娇","genre":"词","date":"2011-11-10","volumeNo":1,"body":["回首往事，","多长恨、一时音容相斥。","不堪泪雨，","分外迢迢，","可是恋谊双思。","瑟瑟秋风，","夜幕随江，","此景谁待织。","老去黄昏，","了却符音情字。","初行朦胧恋事，","惆怅别时，","应诺言誓。","不该不该，","远边落，","一蝶一雁两翅。","临江小唱，","流星三","六月，","怀阳光炽。","应该是已，","冥冥已在消逝。"]},{"id":"qz1321156339","title":"永遇乐·念","genre":"词","date":"2011-11-06","volumeNo":1,"body":["姿若朦胧，","心如青花，","书刻楷瓷。","风吹临江，","心思忆过，","天涯何处是？","弹琵琶曲，","轻飞舞梦，","簌簌清霜泪并。","横眉画，","踟躇秋夜，","自是一雁双逝。","菊花深情，","画心画水唱，","歌方是追忆。","往事回首，","花去花零。","零星零碎泣。","深夜无光，","窗前远眺，","微辰落泪琦。","悲离合，","青花不再，","流水无记。"]},{"id":"qz1320559253","title":"乌夜啼","genre":"古体","date":"2011-11-06","volumeNo":1,"body":["满堂春花秋横，","笑盈盈，","自古回眸一笑倾离别。","琉璃月，","朱颜碎，","缘何赐？","从来无所相似满愁没？"]},{"id":"qz1320559196","title":"浪淘沙","genre":"词","date":"2011-11-02","volumeNo":1,"body":["桃深水清潭，","绕簌风岚。","悔梦迷离轻容颜。","画雾芬裳琐弥苒，","秋去秋寒。","几度暗香泛，","旧故深繁。","风吹杨柳杨柳岸，","花飘柳絮若人圆，","一潇一叹。"]},{"id":"qz1320559137","title":"临江仙","genre":"词","date":"2011-11-01","volumeNo":1,"body":["声声牧笛还月来，","末路新出青苔，","月泻水草生珠海。","霜言念庆怀，","又是风秋满。","古逢亲茹今相莹，","莹茹朦春晓雾，","弹指倾灭飞彩暧。","故地消青月，","沉雪复舟脉。"]},{"id":"qz1319335273","title":"望春","genre":"古体","date":"2011-10-21","volumeNo":1,"body":["鸟飞江南独望春，冬霞黄天暗色昏。","风云几度恋天气，华夏有人爱江春。","寂然三月花香放，零落飘雪换冬坤。","烟花七现无持意，人间一冷梦无存。"]},{"id":"qz1318735638","title":"青玉案·青玉","genre":"词","date":"2011-10-14","volumeNo":1,"body":["秋幻彩蝶入梦随，","烛丝丝，","明暗心。","冬醉一坛情阳落。","乌锁琉琦，","云深清月，","谁卧小荷池。","相离莫过思别恨，","黄昏晕抱倾世碎。","青玉几何惜情怨。","江天修远，","人黄日岁，","从未复欢颜。"]},{"id":"qz1318735322","title":"渔家傲·梦非来人","genre":"词","date":"2011-10-13","volumeNo":1,"body":["轩乐清风笛悠悠，","篱蔷花色暗蝶飞，","清风笛尽花蝶恋。","深明月，","离花留沫稀蝶弱。","","谁闻失逝最常是，","一生何再一相似，","不论沧海曲云日。","人长恨，","梦非来人哪般觅。"]},{"id":"qz1318735888","title":"风雾","genre":"七言","date":"2011-10-11","volumeNo":1,"body":["秋风渲雾晨稀混，","紫烟羞月夜昏明。","哪来红尘花柳尽，","修得云灵飛缘情。"]},{"id":"qz1317956807","title":"情尽缘散","genre":"古体","date":"2011-10-03","volumeNo":1,"body":["半空幽幽传清声，丛林深深飘流萤。","天星虽短留痕迹，更是人黄旧故情。","原来莲水怜人爱，莲子只为充风景。","低卧荷亭汾自嘲，仰望狼牙俱天明。","天明又待夕阳穷，起来黄酒唱歌晴。","曾疑彩云是天有，尘世谁见彩云灵。","野雨霪霪若霜雪，不配宠降下天庭。","几翻愁苦寻织女，谁知织女痴汉星。","银河迢迢约牵手，人在七夕羡郎星。","风刮辽烟泪并齐，一度春秋梦终醒。"]},{"id":"qz1317275158","title":"鹊桥仙","genre":"词","date":"2011-09-28","volumeNo":1,"body":["高空锁雾，","星色呈洁，","云缠两情河汉。","天边引尽天江鹊，","飞话下坠葵花岸。","重重暗月，","水痕凑缘，","织女飘传郎唤。","一轮一度七夕会，","无由暮夜鹊桥宴。"]},{"id":"qz1317274483","title":"蝶恋花·瑟瑟秋风","genre":"词","date":"2011-09-27","volumeNo":1,"body":["瑟瑟秋风别处是。","树枯黄躁，","落叶东归去。","人生四季应得许，","哪来高愁入肠头。","回首更是无心泪，","今若分别，","可怜单传线。","人自唤人人憔悴，","我亦思君君归去。"]},{"id":"qz1316929597","title":"疑问","genre":"古体","date":"2011-09-21","volumeNo":1,"body":["四周光耀迟，","水滴刺人脾。","是日初升起，","还又落阳时？"]},{"id":"qz1316930038","title":"卜算子二首","genre":"词","date":"2011-09-20","volumeNo":1,"body":["一杯穿肠酒，","多少惊魂夜。","滴滴香尽苦寒来，","寒眼梦灶台。","豪怀歌一曲，","声势憾九洲。","此生此景意绵绵，","日落平洋面。","2010.","6.","26","南方有河灿，","取舟小游看。","不知曲名心由赞，","一奏殇气染。","船儿轻轻荡，","段段是愁肠。","天际彩云隔空暗，","月下自吟唱。"]},{"id":"qz1316317779","title":"醉花碎","genre":"古体","date":"2011-09-16","volumeNo":1,"body":["寒风来去人彷徨，","酒杯不应独相残。","滴滴醉醉花花碎，","愁愁走走天天迟。"]},{"id":"qz1315990298","title":"落花","genre":"古体","date":"2011-09-13","volumeNo":1,"body":["花落凭人意，","举篙一天蓝。","今秋今夜事，","花笑花斑斓。"]},{"id":"qz1315813990","title":"中秋夜","genre":"古体","date":"2011-09-12","volumeNo":1,"body":["光辉似箭落零下几层云","同是天涯人何是天上人","葵花没几泪伤心日入是真心","月渗出云落夜雨谁最寞","冷花山野人是过客愁莫相思","生随意满卷愁苦闷不出","何方远又为人即是中原客谁疑","霜雪汇元冬中秋月惶人","三步风声廖骆骨","十年一次梦销魂","单双比翼月炽孤单","寻觅凡间事物难修","望雨月夜激石看天变裂七方","情涣漫罪当快","半生难以许明月"]},{"id":"qz1315813118","title":"水调歌头","genre":"词","date":"2011-09-08","volumeNo":1,"body":["今夜朝夕晚，","风尽一片霞。","天上声声寂静，","若是空无慰。","欲把风铃遮掩，","禁去筝笙笛曲。","又沦佳节日，","天人共赏月，","洁璘归何处。","","月无明，","独消落，","人空喜。","一夜明月，","只有孤独星相伴。","一日分别难忘，","长年相离是愁。","寒尽雨云层，","天涯始沉没，","何泣秋枫过？"]},{"id":"qz1315028132","title":"桃花园","genre":"古体","date":"2011-09-03","volumeNo":1,"body":["桃花园中飞花落，","几泪划下是愁肠。","阿山不久西边日，","丛林稀稀露重萤。"]},{"id":"qz1315027626","title":"落雨","genre":"古体","date":"2011-09-03","volumeNo":1,"body":["轻声积雨即，","一阵脾心凉。","天边有琴艺，","相传为阿谁。"]},{"id":"qz1315027910","title":"沁园春--忆彩云","genre":"词","date":"2011-08-29","volumeNo":1,"body":["秋声寒尽，","百里横鸦，","落与黄昏。","霜风无限叶，","悠然共暮。","前眼荒芜，","殇气沸遒。","共阳山傍，","演绎无双。","若是惆怅万年长，","不知去无常，","可是人间？","周周日夜轮回。","一浮沉星暗昼不尽。","八月齐飞，","踏江步红尘。","若是彩云，","何不留芳。","情来冲怆，","为景悄伤。","何笛忧忧，","满洲中沚最无奈。","醉云花，","清晴沦光影，","只为贻笙。"]},{"id":"qz1315027682","title":"荷花泉","genre":"古体","date":"2011-08-26","volumeNo":1,"body":["曾是荷花泉，复归千里还。","为话无串串，三元不转船。","高河从断喘，危城困人团。","虽始切心唤，留彩红豆环。"]},{"id":"qz1315027714","title":"今宵月","genre":"古体","date":"2011-08-25","volumeNo":1,"body":["人间萧枫处往事落叶痕","醉是今宵夜愿词与明月"]},{"id":"qz1315028110","title":"议春秋","genre":"古体","date":"2011-08-21","volumeNo":1,"body":["秋风湖月鸳鸯纱，","春色满园红豆山。","古扬分道落阳地，","春是萋萋秋是沙。"]},{"id":"qz1313558310","title":"是人间","genre":"七言","date":"2011-08-06","volumeNo":1,"body":["一媚欢笑彩云间，","两轮伤灭云彩间。","今时今曰人暧暧，","来年来月夜凄凄。"]},{"id":"qz1313558186","title":"七夕","genre":"七言","date":"2011-08-06","volumeNo":1,"body":["何时王母一双枷，","南北潮流半佳家。","共是明月相邀影，","谁怜七夕过桥家。"]},{"id":"qz1306561982","title":"观莲诗","genre":"古体","date":"2011-05-18","volumeNo":1,"body":["一目欢影迹，两零泪星流。","无尽追回忆，惶恐恨难从。","幽幽谷中风，不去清泉云。","归梦入形色，怆然湛海临。"]},{"id":"qz1304301124","title":"灵古送别","genre":"古体","date":"2011-05-01","volumeNo":1,"body":["三重赤心求红足，临提羡壁鸳鸯湖。","半夜推宵只思念，南国红豆又几轮。","人上人下人何在，人去飘空月更圆。","一生碰触为半题，不得残卷泪难留。"]},{"id":"qz1306563288","title":"忆旧别","genre":"古体","date":"2011-04-06","volumeNo":1,"body":["君不见几路伤泣鬼神惊，","惆怅知己漫归来。","君不见高山远瞩高山间，","一段殇情一段痴。","噫且欢乐悔晚归，","今来早入无喝人。","长杯空对月色晚，","竹帘久绝青苔出。","甚念秋季小河边，","痛悲枫叶满春窗。","不是人情偏使情，","复使人情愁满情。","东南偶，","西沙渡，","莫停曲，","更一杯。","河边赏荷菊，","再来月色满光珠。","夜下空留三影处，","只恨满月沁人心。","不求月影能分人，","惟愿承接古人言。","莫道分离愁意深，","还须明过满别情。","今来把欢酒一杯，","为使清泪不断流。","促暮月，","青山飞，","莫听长空雁悲声，","一叫便退千古情。"]},{"id":"qz1317885170","title":"残风尽香","genre":"古体","date":"2011-01-06","volumeNo":1,"body":["残风尽香拂衣裳，星辰微灿月明灯。","两河隔迹路多远，清塘暗索梦相牵。","幽丛絮絮飞蝶莲，流漪不止渡花仙。","伐光可得浩长江，离绝冬蹙恋归迁。"]},{"id":"qz1304141244","title":"秋末","genre":"古体","date":"2010-12-30","volumeNo":1,"body":["秋枫挂天上夕阳无星伴","同意莫同路两岸心同露","晖如雪并泪同道透骨寒风到","一曲终散尽空绝夜空静","遥月寄思幽草鸣深故人何方","月凄凄独留月色月稀照","不尽思挥难去寥落一笔墨宣上","单提兰亭序三述叙清愁","河岸昔柳流轻泪坐山思水流哪方","梦山镀金秋叶如思","刻舟求玉盈盈爱诗","葵阳落瑰蔷接花径不留秋色香"]},{"id":"qz1317884993","title":"欢喜前朝梦","genre":"古体","date":"2010-10-19","volumeNo":1,"body":["欢喜前朝梦，桃花爱雨帘。","心无飞彩凤，却存千里云。","遥月寄千情，浩冰水成心。","送吟思旧赋，紫灵万色浓。","秋枫向天归何处，却恨梢头会日圆。"]}]